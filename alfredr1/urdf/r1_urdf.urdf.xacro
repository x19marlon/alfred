<?xml version="1.0"?>
<robot name="r1_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ========= Xacro Import =========-->
    <xacro:include filename="$(find alfredr1)/urdf/colors.urdf.xacro" />
    <xacro:include filename="$(find alfredr1)/urdf/body_r1.urdf.xacro" />
    <xacro:include filename="$(find alfredr1)/urdf/head_r1.urdf.xacro" />
    <xacro:include filename="$(find alfredr1)/urdf/arms_r1.urdf.xacro"/>
    <xacro:include filename="$(find alfredr1)/urdf/legs_r1.urdf.xacro" />
    <xacro:colors/>

    <!-- ========= Xacro include nuguet =========-->
    <xacro:body_r1 joint1="waist_yaw_joint"/>
    <xacro:head_r1 joint1="head_yaw_joint"/>
    <xacro:arm prefix="left" reflect="1"
               joint1="left_shoulder_roll_joint"
               joint2="left_shoulder_yaw_joint"
               joint3="left_elbow_joint"
               joint4="left_wrist_roll_joint"/>
    <xacro:arm prefix="right" reflect="-1"
               joint1="right_shoulder_roll_joint"
               joint2="right_shoulder_yaw_joint"
               joint3="right_elbow_joint"
               joint4="right_wrist_roll_joint"/>
    <xacro:leg prefix="left"  reflect="1" 
               joint1="left_hip_roll_joint"
               joint2="left_hip_yaw_joint"
               joint3="left_knee_joint"
               joint4="left_ankle_pitch_joint"
               joint5="left_ankle_roll_joint"/>
    <xacro:leg prefix="right"  reflect="-1" 
               joint1="right_hip_roll_joint"
               joint2="right_hip_yaw_joint"
               joint3="right_knee_joint"
               joint4="right_ankle_pitch_joint"
               joint5="right_ankle_roll_joint"/>
    
    <!-- ========= base link =========-->
    <link name="pelvis_link">
        <inertial>
            <origin xyz="0.026921 0.000184 -0.070405" rpy="0 0 0"/>
            <mass value="2.24682"/>
            <inertia ixx="0.006461" ixy="5e-06" ixz="3.7e-05" iyy="0.00381" iyz="-1.2e-05" izz="0.006198"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://alfredr1/urdf/meshes/pelvis_link.STL"/>
            </geometry>
            <material name="light_grey"/>
        </visual>
        <collision>
            <origin xyz="0.024748 0 -0.067283" rpy="0 0 0"/>
            <geometry>
                <box size="0.104 0.104 0.1" />
            </geometry>
        </collision>
    </link>


    <!-- ========= joints =========-->
     <joint name="waist_roll_joint" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="pelvis_link"/>
        <child link="waist_roll_link"/>
        <axis xyz="1 0 0"/>
        <limit lower="-0.5236" upper="0.5236" effort="60" velocity="18.8"/>
    </joint>

    <joint name="head_pitch_joint" type="revolute">
        <origin xyz="-0.006 0.03155 0.255" rpy="0 0 0"/>
        <parent link="waist_yaw_link"/>
        <child link="head_pitch_link"/>
        <axis xyz="0 1 0"/>
        <limit lower="-0.62832" upper="0.62832" effort="33" velocity="33.4"/>
    </joint>

    <joint name="left_shoulder_pitch_joint" type="revolute">
        <origin xyz="0 0.085688 0.19749" rpy="0.26187 0 0"/>
        <parent link="waist_yaw_link"/>
        <child link="left_shoulder_pitch_link"/>
        <axis xyz="0 1 0"/>
        <limit lower="-3.1416" upper="2.0944" effort="60" velocity="18.8"/>
    </joint>

    <joint name="right_shoulder_pitch_joint" type="revolute">
        <origin xyz="0 -0.085688 0.19749" rpy="-0.26187 0 0"/>
        <parent link="waist_yaw_link"/>
        <child link="right_shoulder_pitch_link"/>
        <axis xyz="0 1 0"/>
        <limit lower="-3.1416" upper="2.0944" effort="60" velocity="18.8"/>
    </joint>

    <joint name="left_hip_pitch_joint" type="revolute">
        <origin xyz="0.0325000000000034 0.0704672446672152 -0.0902350676234607" rpy="-0.436332312998619 0 0"/>
        <parent link="pelvis_link"/>
        <child link="left_hip_pitch_link"/>
        <axis xyz="0 1 0"/>
        <limit lower="-2.932153143" upper="2.548180708" effort="60" velocity="18.8"/>
    </joint>

    <joint name="right_hip_pitch_joint" type="revolute">
        <origin xyz="0.0325000000000034 -0.0704672446672152 -0.0902350676234607" rpy="0.436332312998619 0 0"/>
        <parent link="pelvis_link"/>
        <child link="right_hip_pitch_link"/>
        <axis xyz="0 1 0"/>
        <limit lower="-2.932153143" upper="2.548180708" effort="60" velocity="18.8"/>
    </joint>


    
</robot>