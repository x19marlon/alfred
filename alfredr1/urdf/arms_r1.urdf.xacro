<?xml version="1.0"?>
<robot name="arms_r1" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ========= Xacro macro =========-->
    <xacro:macro name="arm" params="prefix reflect joint1 joint2 joint3 joint4">

        <!-- =========== shoulder ===========-->
        <link name="${prefix}_shoulder_pitch_link">
            <inertial>
                <origin xyz="0.00294386 0.04476868 -0.02286868" rpy="0 0 0"/>
                <mass value="0.83794992"/>
                <inertia ixx="0.00066072" ixy="-0.00000492" ixz="0.00001580" iyy="0.00060170" iyz="0.00005557" izz="0.00057741"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://alfredr1/urdf/meshes/${prefix}_shoulder_pitch_link.STL"/>
                </geometry>
                <material name="white"/>
            </visual>
            <collision>
                <origin xyz="0.00158 ${reflect * 0.047391} -0.02545" rpy="0 0 0"/>
                <geometry>
                    <sphere radius="0.040507" />
                    <box size="0.068041 0.051777 0.123282"/>
                </geometry>
            </collision>
        </link>

        <link name="${prefix}_shoulder_roll_link">
            <inertial>
                <origin xyz="-0.037828 ${reflect * 0.003967} -0.066496" rpy="0 0 0"/>
                <mass value="0.740212"/>
                <inertia ixx="0.000971" ixy="-0.000004" ixz="0.000101" iyy="0.001089" iyz="0.000022" izz="0.000573"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://alfredr1/urdf/meshes/${prefix}_shoulder_roll_link.STL"/>
                </geometry>
                <material name="white"/>
            </visual>
            <collision>
                <origin xyz="-0.034753 0 -0.036017" rpy="0 0 0"/>
                <geometry>
                    <box size="0.083526 0.053784 0.141323" />
                </geometry>
            </collision>
        </link>

        <joint name="${joint1}" type="revolute">
            <origin xyz="0.03445 ${reflect * 0.047132} -0.025693" rpy="0 0 0"/>
            <parent link="${prefix}_shoulder_pitch_link"/>
            <child link="${prefix}_shoulder_roll_link"/>
            <axis xyz="1 0 0"/>
            <limit lower="-0.22689" upper="2.4784" effort="60" velocity="18.8"/>
        </joint>

        <link name="${prefix}_shoulder_yaw_link">
            <inertial>
                <origin xyz="0.013143 -0.004355 -0.072948" rpy="0 0 0"/>
                <mass value="0.738441"/>
                <inertia ixx="0.000829" ixy="0.000015" ixz="0.000108" iyy="0.000852" iyz="-0.000035" izz="0.000469"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://alfredr1/urdf/meshes/${prefix}_shoulder_yaw_link.STL"/>
                </geometry>
                <material name="white"/>
            </visual>
            <collision>
                <origin xyz="0.00158 ${reflect * -0.00158} -0.060028"  rpy="0 0 0"/>
                <geometry>
                    <box size="0.068041 0.051777 0.123282"/>
                </geometry>
            </collision>
        </link>

        <joint name="${joint2}" type="revolute">
            <origin xyz="-0.03445 ${reflect * 0.0043} -0.10835" rpy="0 0 0"/>
            <parent link="${prefix}_shoulder_roll_link"/>
            <child link="${prefix}_shoulder_yaw_link"/>
            <axis xyz="0 0 1"/>
            <limit lower="-1.9199" upper="1.9199" effort="33" velocity="33.4"/>
        </joint>

        <!-- =========== elbow ===========-->
        <link name="${prefix}_elbow_link">
            <inertial>
                <origin xyz="0.072371 -0.024612 -0.011566" rpy="0 0 0"/>
                <mass value="0.759419"/>
                <inertia ixx="0.000550" ixy="0.000179" ixz="0.000030" iyy="0.000892" iyz="-0.000017" izz="0.000936"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://alfredr1/urdf/meshes/${prefix}_elbow_link.STL"/>
                </geometry>
                <material name="white"/>
            </visual>
            <collision>
                <origin xyz="0.041112 ${reflect * -0.026799} -0.008831" rpy="0 0 0"/>
                <geometry>
                    <box size="0.144533 0.070679 0.073991"/>
                </geometry>
            </collision>
        </link>

        <joint name="${joint3}" type="revolute">
            <origin xyz="0.016191 ${reflect * 0.026461} -0.082858" rpy="0 0 0"/>
            <parent link="${prefix}_shoulder_yaw_link"/>
            <child link="${prefix}_elbow_link"/>
            <axis xyz="0 1 0"/>
            <limit lower="-0.97564" upper="2.1852" effort="33" velocity="33.4"/>
        </joint>

        <!-- =========== wrist ===========-->
        <link name="${prefix}_wrist_roll_link">
            <inertial>
                <origin xyz="0.068045 -0.001688 0.001392" rpy="0 0 0"/>
                <mass value="0.324767"/>
                <inertia ixx="0.000158" ixy="0.000023" ixz="-0.000010" iyy="0.000716" iyz="0.000004" izz="0.000705"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://alfredr1/urdf/meshes/${prefix}_wrist_roll_link.STL"/>
                </geometry>
                <material name="dark"/>
            </visual>
            <collision>
                <origin xyz="0.0686 ${reflect * -0.003574} 0" rpy="0 0 0"/>
                <geometry>
                    <box size="0.140805 0.070679 0.060276" />
                </geometry>
            </collision>
        </link>

        <joint name="${joint4}" type="revolute">
            <origin xyz="0.11218 ${reflect * -0.03002} -0.011702" rpy="0 0 0"/>
            <parent link="${prefix}_elbow_link"/>
            <child link="${prefix}_wrist_roll_link"/>
            <axis xyz="1 0 0"/>
            <limit lower="-1.9199" upper="1.9199" effort="33" velocity="33.4"/>
        </joint>

    </xacro:macro>

</robot>